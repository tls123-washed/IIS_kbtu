# Для локального запуска. Для пилота используйте APP_ENV=pilot и HTTPS.
APP_ENV=dev
APP_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=postgresql://campus_app:CHANGE_ME@127.0.0.1:5432/campus_threads_pilot
APP_SECRET=CHANGE_ME

# code = письмо, domain = только проверка @kbtu.kz, microsoft = Entra, both = письмо и Entra.
AUTH_MODE=code
# MS_LOGIN_TENANT_ID=
# MS_LOGIN_CLIENT_ID=
# MS_LOGIN_CLIENT_SECRET=

# file сохраняет письма в .mailbox/. Для реальной отправки используйте graph или smtp.
MAIL_MODE=file
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_SENDER=your.name@kbtu.kz
# GRAPH_TOKEN_CACHE=.mail-auth/graph.cache
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
